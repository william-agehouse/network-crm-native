# Network CRM settings, for running it from the source code.
#
# The Mac app does not need this file: everything here is on its Settings page.
# Running from source, copy this file to secrets/.env, fill in what you want,
# and restart. Everything is optional. Lines starting with # are switched off.
#
# Keep secrets/.env to yourself: it holds your keys. It is never published.

# Turns on Ask, story rewrites and message drafts. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Your name and the address you write from, so every import can tell your side
# of a conversation from theirs. Several addresses: put a comma between them.
SELF_NAME=
SELF_EMAIL=

# Which AI model Ask uses.
# ANTHROPIC_MODEL=claude-opus-5-5

# Gmail accounts to import from, comma separated. The Data page walks you
# through the one-time Google setup this needs.
# GMAIL_ACCOUNTS=you@example.com

# The port the app listens on, on this Mac only.
# APP_PORT=8765
